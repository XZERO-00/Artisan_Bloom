rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isVendor() {
      return isSignedIn() && getUserRole() == 'vendor';
    }

    // ── Users collection ─────────────────────────────────────────────────
    // Any signed-in user can read their own doc.
    // Only admins can read ALL users or update isBanned/isApproved fields.

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);  // Created during registration
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Products collection ──────────────────────────────────────────────
    // Anyone can read products.
    // Only vendors can create/update their OWN products.
    // Admins can modify or delete any product.

    match /products/{productId} {
      allow read: if true;
      allow create: if isVendor() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isAdmin() ||
        (isVendor() && resource.data.vendorId == request.auth.uid);
      allow delete: if isAdmin() ||
        (isVendor() && resource.data.vendorId == request.auth.uid);
    }

    // ── Orders collection ────────────────────────────────────────────────
    // Only the order owner or an admin can read/write orders.

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Threads collection ───────────────────────────────────────────────
    // Only the customer and vendor involved in the thread can access it.
    // Admins can read all threads.

    match /threads/{threadId} {
      function isParticipant() {
        return isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.vendorId == request.auth.uid
        );
      }

      allow read: if isParticipant() || isAdmin();
      allow create: if isSignedIn();  // Customer creates the thread
      allow update: if isParticipant() || isAdmin();
      allow delete: if isAdmin();

      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/threads/$(threadId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/threads/$(threadId)).data.vendorId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          get(/databases/$(database)/documents/threads/$(threadId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/threads/$(threadId)).data.vendorId == request.auth.uid
        );
        allow update, delete: if false; // Messages are immutable
      }
    }
  }
}
